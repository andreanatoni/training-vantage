#!/bin/bash
# Training Vantage CLI - Main dispatcher

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
SCRIPTS_DIR="$SCRIPT_DIR/scripts"

# Colors
GREEN='\033[0;32m'
RED='\033[0;31m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

# Global athlete context
ATHLETE_ID="${TV_ATHLETE_ID:-default}"
if [ "$1" = "--athlete" ]; then
    if [ -z "$2" ]; then
        echo -e "${RED}Uso non valido:${NC} tv --athlete <id> <command> [args]"
        exit 1
    fi
    ATHLETE_ID="$2"
    shift 2
fi
export TV_ATHLETE_ID="$ATHLETE_ID"

# Help
show_help() {
    cat << EOF
╔═══════════════════════════════════════════════════════════════════╗
║                    TRAINING VANTAGE CLI v1.0                      ║
╚═══════════════════════════════════════════════════════════════════╝

USAGE: tv [--athlete <id>] <command> [args]

COMANDI DISPONIBILI (Priorità 1 — Tracking base):

  weigh <peso> <bf%> [note]
      Registra pesata, calcola FFM/BMR, aggiorna composition.json
      Esempio: tv weigh 68.5 13.1 "Dopo settimana scarico"

  status
      Mostra stato attuale: ultima pesata, zone, prossima gara, alerts
      Esempio: tv status

  zones [test_time] [note]
      Mostra zone attuali o ricalcola da nuovo test 5km
      Esempio: tv zones              # mostra attuali
      Esempio: tv zones 18:26        # ricalcola da test
      Esempio: tv zones 17:55 "Gara Roma-Ostia"

COMANDI DISPONIBILI (Priorità 2 — Nutrizione):

  nutrition setup-base
      Wizard interattivo per creare/aggiornare il template base pasti atleta
      Prerequisito: eseguire prima nutrition setup-profile per creare NUTRITION_PROFILE.json
      Flag utili: --autodraft, --allow-manual-block-overrides
      Nota: se non usi --athlete e il contesto e' default, il Nome atleta inserito diventa la cartella target
      Output:
        - data/athletes/<id>/nutrition_base_template.json
        - knowledge/athletes/<id>/nutrition-base-template.md
      Esempio: tv nutrition setup-base

  nutrition setup-profile
      Wizard interattivo per profilazione nutrizione atleta (core + BIA avanzata opzionale)
      Nota: se non usi --athlete e il contesto e' default, il Nome atleta inserito diventa la cartella target
      Output:
        - data/athletes/<id>/NUTRITION_PROFILE.json
        - knowledge/athletes/<id>/nutrition-profile.md
      Esempio: tv nutrition setup-profile

  nutrition validate-template [--json]
      Validazione pre-flight del nutrition_base_template atleta (planner-ready)
      Esempio: tv nutrition validate-template

  plan <categoria>
      Genera piano nutrizionale quantitativo per categoria
      Categorie: rest, forza, easy-run, qualita, tempo, lungo, pizza-day, domenica
      Esempio: tv plan forza
      Esempio: tv plan --all         # rigenera tutti gli 8 piani
      Esempio: tv plan week 2026-W11 # genera piano nutrizione per tutta la settimana dal running_plan
      Esempio: tv plan month 2026-03 # genera piano nutrizione per il mese dal running_plan


COMANDI DISPONIBILI (Priorità 3 — Running):

  week <N>
      Mostra piano running per settimana N (W1-W20)
      Esempio: tv week 1
      Esempio: tv week 20

  running generate --from YYYY-MM-DD --to YYYY-MM-DD [--goal-race YYYY-MM-DD]
      Genera piano running periodizzato per finestra temporale (mesi o blocchi lunghi)
      Esempio: tv running generate --from 2026-03-01 --to 2026-06-30 --goal-race 2026-10-18
      Esempio: tv running generate --from 2026-03-01 --to 2026-06-30 --goal-race 2026-10-18 --enforce-tid

  running setup [--no-history]
      Colloquio coach interattivo (Daniels/Pfitz/Canova/Seiler/Hudson) per configurare il blocco running
      Nota: se non usi --athlete e il contesto e' default, il Nome atleta inserito diventa la cartella target
      Esempio: tv running setup
      Esempio: tv running setup --no-history

  running week <N>
      Mostra dettaglio settimana N dal file running_plan dell'atleta corrente (data/athletes/<id>/running_plan.json)
      Esempio: tv running week 3

  running month <YYYY-MM>
      Mostra riepilogo mensile volumi/day-type dal piano generato
      Esempio: tv running month 2026-04

  running summary
      Mostra riepilogo periodo completo (mensili + taper preview)
      Esempio: tv running summary

COMANDI DISPONIBILI (Utility):

  food add <args...>
      Aggiunge alimento a knowledge/food-db.md + data/FOOD_DB.json + data/FOOD_DB_TO_LARN_MAPPING.json
      Sintassi 1: tv food add "<nome>" <riferimento> <kcal> <proteine> <cho> <grassi> <fibre> [fonte]
      Sintassi 2: tv food add <url_crea>
      Sintassi replace: tv food add --replace "<nome_o_id_esistente>" <argomenti>
      Esempio: tv food add "Gallette riso" "100 g" 387 7.4 81.0 2.8 3.5 CREA
      Esempio: tv food add https://www.alimentinutrizione.it/tabelle-nutrizionali/150030
      Esempio: tv food add --replace "Yogurt greco 0%" https://www.alimentinutrizione.it/tabelle-nutrizionali/150030

  food sync
      Rigenera knowledge/food-db.md da data/FOOD_DB.json e valida mapping
      Esempio: tv food sync

  food check
      Valida coerenza FOOD_DB / mapping senza scrivere file
      Esempio: tv food check

  food crawl-index
      Estrae indice alfabetico CREA (nome + url + id) in data/CREA_INDEX.json
      Esempio: tv food crawl-index

  food import-crea <args...>
      Importa alimenti da CREA in FOOD_DB (uno, lista o tutti da indice)
      Esempio: tv food import-crea --id 150030
      Esempio: tv food import-crea --ids 150030,120010 --replace-existing
      Esempio: tv food import-crea --all --limit 50

  food rebuild-from-crea
      Backup + rebuild completo FOOD_DB, mapping e markdown da data/CREA_INDEX.json
      Esempio: tv food rebuild-from-crea

  food sync-dietabit [--no-merge]
      Crawl completo Dietabit -> data/DIETABIT_DB.json, confronto con FOOD_DB e merge safe mancanti
      Esempio: tv food sync-dietabit
      Esempio: tv food sync-dietabit --no-merge

  food build-active
      Genera subset alimenti attivi per atleta in data/athletes/<id>/FOOD_DB_ACTIVE.json
      (estrazione da nutrition_base_template + piani nutrizione atleta)
      Esempio: tv food build-active
      Esempio: tv --athlete spizz food build-active

  food import-mapped [--file data/food_mapped.md] [--dry-run] [--strict-complete]
      Importa mapping massivo food_db_id|larn_portion_id in FOOD_DB_TO_LARN_MAPPING.json
      con validazioni hard, backup automatico e report json/md.
      Esempio: tv food import-mapped --dry-run --strict-complete
      Esempio: tv food import-mapped --file data/food_mapped.md --strict-complete

  food build-catalog [--dry-run] [--no-strict]
      Costruisce data/FOOD_CATALOG.json come cache/report derivata opzionale
      da FOOD_DB + mapping + LARN + PERSONAL_LIMITS.
      Esempio: tv food build-catalog
      Esempio: tv food build-catalog --dry-run

  food validate-data [--with-catalog]
      Valida coerenza strutturale dataset canonici.
      Usa --with-catalog per validare anche FOOD_CATALOG derivato opzionale.
      Esempio: tv food validate-data
      Esempio: tv food validate-data --with-catalog

  analyze <file.csv>
      Analizza export Garmin CSV (distanza/tempo/passo/FC medi)
      Esempio: tv analyze sources/storico.csv

  load import [--tp <tp.csv>] [--garmin <garmin.csv>] [<csv_legacy>]
      Importa storico/planning da CSV TrainingPeaks e/o Garmin in data/athletes/<id>/training_load.json
      Esempio: tv load import sources/workouts-2.csv
      Esempio: tv load import --tp sources/trainingpeaks-last-year.csv --garmin sources/garmin-last-year.csv

Per maggiori informazioni: cat CLAUDE.md
EOF
}

# Dispatch command
case "$1" in
    weigh)
        shift
        python3 -m scripts.tracking.weigh "$@"
        ;;
    status)
        shift
        python3 -m scripts.tracking.status "$@"
        ;;
    zones)
        shift
        python3 -m scripts.tracking.zones "$@"
        ;;
    plan)
        shift
        if [ "$1" = "build-options" ]; then
            echo -e "${YELLOW}Comando legacy archiviato:${NC} 'plan build-options'"
            echo "knowledge/meal_options/*.json e' l'unica source-of-truth (runtime/build/migrazioni)."
            exit 1
        else
            python3 -m scripts.nutrition.plan "$@"
        fi
        ;;
    week)
        shift
        python3 -m scripts.running.week "$@"
        ;;
    running)
        shift
        if [ "$1" = "setup" ]; then
            shift
            python3 -m scripts.running.running_setup "$@"
        else
            python3 -m scripts.running.running_plan "$@"
        fi
        ;;
    food)
        shift
        if [ "$1" = "add" ]; then
            shift
            python3 -m scripts.food.food_add "$@"
        elif [ "$1" = "sync" ]; then
            python3 -m scripts.food.sync_food_db
        elif [ "$1" = "check" ]; then
            python3 -m scripts.food.sync_food_db --check
        elif [ "$1" = "crawl-index" ]; then
            python3 -m scripts.food.crea_import crawl-index
        elif [ "$1" = "import-crea" ]; then
            shift
            python3 -m scripts.food.crea_import import-crea "$@"
        elif [ "$1" = "rebuild-from-crea" ]; then
            python3 -m scripts.food.rebuild_food_db_from_crea
        elif [ "$1" = "sync-dietabit" ]; then
            shift
            python3 -m scripts.food.dietabit_sync "$@"
        elif [ "$1" = "build-active" ]; then
            python3 -m scripts.food.build_active_food_db
        elif [ "$1" = "import-mapped" ]; then
            shift
            python3 -m scripts.food.import_mapped "$@"
        elif [ "$1" = "build-catalog" ]; then
            shift
            python3 -m scripts.food.build_food_catalog "$@"
        elif [ "$1" = "validate-data" ]; then
            shift
            python3 -m scripts.food.data_validator data "$@"
        elif [ "$1" = "auto-map-larn" ] || [ "$1" = "map-larn" ] || [ "$1" = "extract-portions" ]; then
            echo -e "${YELLOW}Comando legacy archiviato:${NC} '$1'"
            echo "Usa: tv food import-mapped + tv food validate-data"
            echo "Opzionale: tv food build-catalog"
            exit 1
        else
            echo -e "${RED}Uso non valido. Esempi:${NC} tv food add \"Nome\" \"100 g\" 100 10 10 5 2 CREA"
            echo "                           tv food add https://www.alimentinutrizione.it/tabelle-nutrizionali/150030"
            echo "                           tv food sync"
            echo "                           tv food check"
            echo "                           tv food crawl-index"
            echo "                           tv food import-crea --id 150030"
            echo "                           tv food rebuild-from-crea"
            echo "                           tv food sync-dietabit"
            echo "                           tv food build-active"
            echo "                           tv food import-mapped --dry-run --strict-complete"
            echo "                           tv food build-catalog --dry-run"
            echo "                           tv food validate-data"
            exit 1
        fi
        ;;
    nutrition)
        shift
        if [ "$1" = "setup-base" ]; then
            shift
            python3 -m scripts.nutrition.setup_base "$@"
        elif [ "$1" = "setup-profile" ]; then
            shift
            python3 -m scripts.nutrition.setup_profile "$@"
        elif [ "$1" = "validate-template" ]; then
            shift
            python3 -m scripts.nutrition.validate_template "$@"
        else
            echo -e "${RED}Uso non valido. Esempi:${NC} tv nutrition setup-base"
            echo "                          tv nutrition setup-profile"
            echo "                          tv nutrition validate-template"
            exit 1
        fi
        ;;
    analyze)
        shift
        python3 -m scripts.running.analyze "$@"
        ;;
    load)
        shift
        if [ "$1" = "import" ]; then
            shift
            python3 -m scripts.running.import_training_load "$@"
        else
            echo -e "${RED}Uso non valido. Esempi:${NC} tv load import sources/workouts-2.csv"
            echo "                          tv load import --tp sources/trainingpeaks-last-year.csv --garmin sources/garmin-last-year.csv"
            exit 1
        fi
        ;;
    help|--help|-h|"")
        show_help
        ;;
    *)
        echo -e "${RED}Comando non riconosciuto: $1${NC}"
        echo "Usa 'tv help' per la lista dei comandi disponibili"
        exit 1
        ;;
esac
